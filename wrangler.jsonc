{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apieverything",
  "main": "worker.js",
  "compatibility_date": "2026-06-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "everything.rellia.org", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://kavodsarpdvzmaqrkunv.supabase.co"
  }
}
